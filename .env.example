# --- public access / n8n ---
PUBLIC_URL=https://your-fixed-domain.example
N8N_VERSION=1.66.0
N8N_ENCRYPTION_KEY=change-me-long-random-encryption-key-for-n8n
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# --- worker <-> n8n ---
DHOOP_CALLBACK_SECRET=change-me-long-random-dhoop-secret
DHOOP_CALLBACK_DEFAULT=http://n8n:5678/webhook/dhoop-result

# --- Overpass ---
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_USER_AGENT=Dhoop/0.1 (contact: dhoop@example.com)
OVERPASS_TIMEOUT_S=25

# --- model / render ---
RADIUS_M=300
VIEW_RADIUS_M=180
FLOOR_HEIGHT_M=3.0
SAMPLE_HEIGHT_OFFSET_M=1.2
DEFAULT_BUILDING_HEIGHT_M=9
MIN_SUN_ELEVATION_DEG=5
SUN_STEP_MIN=5
FRAME_STEP_MIN=30
MAX_FRAMES=26
RENDER_SIZE=720
RENDER_SAMPLES=24
RENDER_FPS=4

# --- ops ---
WORKER_CONCURRENCY=1
JOB_TIMEOUT_S=240
BLENDER_STAGE_TIMEOUT_S=150
ARTIFACT_TTL_HOURS=24
RATE_LIMIT_PER_HOUR=5
DEMO_FIXTURES=0
CACHE_DB=/data/cache.sqlite
JOBS_DIR=/data/jobs
